/**
 * RepoLens Wrangler configuration (spec §5, §6).
 *
 * KV namespace created 2026-09-13: `wrangler kv namespace create
 * IDEMPOTENCY_KV` (namespace ids are account-scoped resource ids, not
 * secrets).
 *
 * Secrets (GH_PRIVATE_KEY, GH_WEBHOOK_SECRET, GEMINI_API_KEY) are never
 * written here — they are Wrangler secrets / .dev.vars only (spec §6).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repolens",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    // Numeric GitHub App id (registered 2026-09-13, spec §6).
    "GH_APP_ID": "4930895"
  },
  "kv_namespaces": [
    {
      "binding": "IDEMPOTENCY_KV",
      "id": "95a72e9f8e804fa8922d3a91523818db"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "REVIEW_QUEUE",
        "queue": "repolens-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "repolens-jobs",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "repolens-jobs-dlq"
      }
    ]
  }
}
